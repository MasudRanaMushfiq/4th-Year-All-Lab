{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build MPI C program",
            "type": "process",
            "command": "gcc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-DMSMPI_NO_SAL",
                "-I",
                "C:\\Program Files (x86)\\Microsoft SDKs\\MPI\\Include",
                "-L",
                "C:\\Program Files (x86)\\Microsoft SDKs\\MPI\\Lib\\x64",
                "-lmsmpi"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
